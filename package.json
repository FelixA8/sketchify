{
  "name": "sketchify-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first sketching canvas inspired by Excalidraw",
  "scripts": {
    "dev": "next dev --hostname localhost",
    "start": "node server.mjs",
    "vendor": "node scripts/vendor-excalidraw.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run vendor:check && npm run build && npm run test:e2e",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "vendor:check": "node scripts/vendor-excalidraw.mjs --check"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@excalidraw/laser-pointer": "1.3.1",
    "immer": "^10.2.0",
    "next": "^16.4.6",
    "perfect-freehand": "1.2.0",
    "points-on-curve": "1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "4.6.4",
    "tinycolor2": "1.6.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@playwright/test": "^1.65.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
